+function _emit_multi_alloc_cache_clear(state)
+  for each reg in ["rax", "rcx", "rdi"] state.asm=a.push_reg(state.asm,reg) end for
+  state.asm=a.lea_r64_rip(state.asm,"rdi","gc_free_search_cache")
